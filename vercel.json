{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/court-session-management build && node -e \"const fs=require('fs'); fs.cpSync('artifacts/court-session-management/dist', 'dist', {recursive: true});\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
